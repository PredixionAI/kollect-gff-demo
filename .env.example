# --- VOIZ platform ---
VOIZ_BASE_URL=https://jobdispatch-dev.blackcoast-4a3b6000.centralindia.azurecontainerapps.io
# Sent as an X-API-Key header (confirmed against the real platform — the
# VOIZ_MASTER_API_SETUP_AND_VOICE_CATALOG_GUIDE.docx documents Bearer, which
# does not work; see server/lib/voizClient.js).
VOIZ_API_KEY=
VOIZ_WEBHOOK_SECRET=
SIP_TRUNK_ID=

# --- Per-orb agent mapping (screen 3: voice carousel) ---
# Fallback agent while only one persona has a registered agent. Currently
# Priya's agent_id.
VOIZ_DEFAULT_AGENT_ID=
# Set each of these as its agent is registered — the matching orb switches
# from "Coming soon" to selectable automatically (server/routes/voices.js),
# no code change needed. Leave blank until then.
VOIZ_AGENT_ID_PRIYA=
VOIZ_AGENT_ID_SWARA=
VOIZ_AGENT_ID_VIKRAM=

# --- ElevenLabs ("Enhanced Quality" toggle) ---
# Outbound dispatch + outcome retrieval both real (server/lib/elevenLabsClient.js).
# Blank API key = toggle harmlessly falls back to VOIZ. Key lives in your
# ElevenLabs workspace under Developers. Per-voice agents, same pattern as
# VOIZ_AGENT_ID_* above — id 'priya' is Neha (see server/voiceCatalog.js).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_PRIYA=agent_8801m0c50hq8fz08th1mggr19nfr
ELEVENLABS_AGENT_ID_VIKRAM=agent_9001m218ytv2eqgshx4wdqap8w9e
ELEVENLABS_PHONE_NUMBER_ID=

# --- Demo fixed values (PRD 4.1) ---
DEMO_DUE_AMOUNT=45000
DEMO_DUE_DATE=2026-09-05

# --- Booth concurrency (informational — VOIZ enforces the real cap) ---
MAX_CONCURRENCY=5

# --- WhatsApp (Vobiz) ---
# Stays "mock" (logs, no real send, zero cost) until deliberately flipped
# to "live" — real sends cost money per Meta's per-conversation pricing.
WHATSAPP_MODE=mock
WHATSAPP_PROVIDER=vobiz
# Set false only as a TEMPORARY measure while templates await Meta approval
# — sends free-form text instead, which only reaches a recipient who has
# already messaged in within 24h. Does NOT work for a real booth attendee.
# true (or delete this line) once templates are approved.
WHATSAPP_USE_TEMPLATES=true
WHATSAPP_AUTH_ID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_CHANNEL_ID=
WHATSAPP_WABA_ID=
# Escalation hand-off goes here, not to the borrower (PRD §7.1).
WHATSAPP_HUMAN_AGENT_NUMBER=
# Fill in once you register a webhook subscription (POST
# https://api.vobiz.ai/api/v1/messaging/webhooks) — the secret is returned
# only once at creation. Needed for /api/webhooks/vobiz to verify inbound
# deliveries (message.inbound / message.status / call.*).
WHATSAPP_WEBHOOK_SECRET=

# --- Server ---
PORT=3001

# --- GLM 5 (AWS Bedrock) post-call intelligence — tried FIRST, Gemini below
# is the fallback. Leave blank to skip GLM entirely (Gemini runs as before).
GLM_BEDROCK_API_KEY=
GLM_BEDROCK_BASE_URL=https://bedrock-runtime.ap-south-1.amazonaws.com/openai/v1
GLM_MODEL=zai.glm-5

# --- Gemini post-call intelligence (fallback if GLM above is unset/fails) ---
# Leave blank to skip entirely — mock/simulated demo runs never call this,
# and a real call falls back to the real-but-unenhanced VOIZ data if both
# providers are blank or fail. See implementation_plan.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Telemetry: Google Sheets (optional but recommended for live events) ---
# Deploy server/googleAppsScript.js as a Google Apps Script Web App and paste
# the resulting URL here.  Leave blank to skip Google Sheets and use the local
# fallback (server/data/sessions.json + GET /api/telemetry/export-csv).
# See docs/GOOGLE_SHEETS_SETUP.md for the 2-minute setup guide.
GOOGLE_SHEET_WEBHOOK_URL=
