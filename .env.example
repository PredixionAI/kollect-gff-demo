# --- Voice provider switch (this branch) ---
# 'elevenlabs' (default on feature/elevenlabs) or 'voiz'. All VOIZ config
# below still works — flip this back with no code change.
VOICE_PROVIDER=elevenlabs

# --- ElevenLabs Agents Platform ---
# See docs/ELEVENLABS_MIGRATION.md for where each value comes from.
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Sent as an `xi-api-key` header (NOT Bearer). Create under ElevenLabs
# dashboard → Developers → API keys, with Agents Platform permissions.
ELEVENLABS_API_KEY=
# The imported phone number the agent dials FROM (Agents → Phone numbers).
ELEVENLABS_PHONE_NUMBER_ID=
# 'sip-trunk' or 'twilio' — must match how that phone number was imported.
ELEVENLABS_TRANSPORT=sip-trunk
# Per-orb agent mapping — same contract as the VOIZ one below: set an env
# var and the orb switches from "Coming soon" to selectable automatically.
ELEVENLABS_DEFAULT_AGENT_ID=
ELEVENLABS_AGENT_ID_PRIYA=
ELEVENLABS_AGENT_ID_ARJUN=
ELEVENLABS_AGENT_ID_MEERA=
ELEVENLABS_AGENT_ID_VIKRAM=
ELEVENLABS_AGENT_ID_RITU=
# Shared secret the agent's webhook tools send as X-Tool-Secret
# (server/routes/agentTools.js). Blank = unauthenticated (localhost
# rehearsal only — never expose a public tunnel without this set).
ELEVENLABS_TOOL_SECRET=

# --- VOIZ platform ---
VOIZ_BASE_URL=https://jobdispatch-dev.blackcoast-4a3b6000.centralindia.azurecontainerapps.io
# Sent as an X-API-Key header (confirmed against the real platform — the
# VOIZ_MASTER_API_SETUP_AND_VOICE_CATALOG_GUIDE.docx documents Bearer, which
# does not work; see server/lib/voizClient.js).
VOIZ_API_KEY=
VOIZ_WEBHOOK_SECRET=
SIP_TRUNK_ID=

# --- Per-orb agent mapping (screen 3: voice carousel) ---
# Fallback agent while only one persona has a registered agent. Currently
# Priya's agent_id.
VOIZ_DEFAULT_AGENT_ID=
# Set each of these as its agent is registered — the matching orb switches
# from "Coming soon" to selectable automatically (server/routes/voices.js),
# no code change needed. Leave blank until then.
VOIZ_AGENT_ID_PRIYA=
VOIZ_AGENT_ID_ARJUN=
VOIZ_AGENT_ID_MEERA=
VOIZ_AGENT_ID_VIKRAM=
VOIZ_AGENT_ID_RITU=

# --- Demo fixed values (PRD 4.1) ---
DEMO_DUE_AMOUNT=45000
DEMO_DUE_DATE=2026-09-05

# --- Booth concurrency (informational — VOIZ enforces the real cap) ---
MAX_CONCURRENCY=5

# --- WhatsApp (Vobiz) ---
# Stays "mock" (logs, no real send, zero cost) until deliberately flipped
# to "live" — real sends cost money per Meta's per-conversation pricing.
WHATSAPP_MODE=mock
WHATSAPP_PROVIDER=vobiz
# Set false only as a TEMPORARY measure while templates await Meta approval
# — sends free-form text instead, which only reaches a recipient who has
# already messaged in within 24h. Does NOT work for a real booth attendee.
# true (or delete this line) once templates are approved.
WHATSAPP_USE_TEMPLATES=true
WHATSAPP_AUTH_ID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_CHANNEL_ID=
WHATSAPP_WABA_ID=
# Escalation hand-off goes here, not to the borrower (PRD §7.1).
WHATSAPP_HUMAN_AGENT_NUMBER=
# Strict caps — see server/lib/whatsappRateLimit.js. Raise only if
# rehearsal actually needs more; don't raise to "make an error go away"
# without checking why the cap was hit first.
WHATSAPP_MAX_PER_MINUTE=5
WHATSAPP_MAX_PER_CASE=3
WHATSAPP_MAX_PER_DAY=30

# --- Server ---
PORT=3001

# --- Gemini post-call intelligence (real-call path only) ---
# Leave blank to skip entirely — mock/simulated demo runs never call this,
# and a real call falls back to the real-but-unenhanced VOIZ data if this
# is blank or the call fails. See implementation_plan.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Telemetry: Google Sheets (optional but recommended for live events) ---
# Deploy server/googleAppsScript.js as a Google Apps Script Web App and paste
# the resulting URL here.  Leave blank to skip Google Sheets and use the local
# fallback (server/data/sessions.json + GET /api/telemetry/export-csv).
# See docs/GOOGLE_SHEETS_SETUP.md for the 2-minute setup guide.
GOOGLE_SHEET_WEBHOOK_URL=
